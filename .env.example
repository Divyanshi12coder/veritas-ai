# ---------------------------------------------------------------------------
# Veritrace environment configuration. Copy to `.env` (repo root) and adjust.
# Nothing here is required for local development: every value has a safe default.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database. SQLite (default) for local dev, PostgreSQL for production.
#   SQLite:     sqlite:///./data/veritrace.db
#   PostgreSQL: postgresql://user:password@host:5432/veritrace
# DATABASE_URL=sqlite:///./data/veritrace.db   (default; resolved relative to the repo root when unset)
DATABASE_URL=

# Comma-separated list of allowed browser origins (your deployed frontend URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-IP limit for POST /api/analyze* (0 disables).
RATE_LIMIT_PER_MINUTE=40

# ----- Models ---------------------------------------------------------------
# auto | tfidf_lr | tfidf_svm | stylometric_rf | stylometric_hgb | transformer
DEFAULT_MODEL=auto
# Optional transformer classifier: Hugging Face hub id or a local directory from ml/train_transformer.py.
# Requires `pip install transformers torch`. Leave empty to use the classical models only.
TRANSFORMER_MODEL=
# Name of the output label that means FAKE for that model (check its config.json id2label).
TRANSFORMER_FAKE_LABEL=LABEL_1

# ----- Retrieval (RAG) ------------------------------------------------------
# tfidf (default, no downloads) | sentence-transformers (needs `pip install sentence-transformers`)
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ----- LLM reasoning (optional) ---------------------------------------------
# none | anthropic | openai   (openai = any OpenAI-compatible endpoint)
LLM_PROVIDER=none
# Leave LLM_MODEL empty to use the provider default.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=40
